<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CartoonCharacters.ViewModels"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="CartoonCharacters.Views.CollectionEditView"
             x:DataType="viewModels:CollectionEditViewModel"
             Background="#2C3E50">

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#95A5A6"/>
        </Style>
        
        <Style Selector="Button.OutlineGreen">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineGreen:pointerover">
            <Setter Property="Background" Value="#27AE6010"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
        </Style>
        
        <Style Selector="Button.OutlineRed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineRed:pointerover">
            <Setter Property="Background" Value="#E74C3C10"/>
            <Setter Property="BorderBrush" Value="#EC7063"/>
        </Style>
        
        <Style Selector="Button.OutlineGray">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#7F8C8D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineGray:pointerover">
            <Setter Property="Background" Value="#7F8C8D10"/>
            <Setter Property="BorderBrush" Value="#95A5A6"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="20">
        
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Margin="0,0,0,20">
            
            <Border Background="#36393F"
                    BorderBrush="#34495E"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="24"
                    Margin="10"
                    Width="450">

                <StackPanel Spacing="14">

                    <TextBlock Text="✏️ Modifier le personnage"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Nom"
                               Foreground="#ECF0F1" 
                               FontWeight="SemiBold"
                               FontSize="12"/>
                    <TextBox Watermark="ex: Homer Simpson"
                             Text="{Binding Name}"/>

                    <TextBlock Text="Description" 
                               Foreground="#ECF0F1" 
                               Margin="0,5,0,0"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                    <TextBox Watermark="ex: Aime les donuts..."
                             Text="{Binding Description}"
                             AcceptsReturn="True"
                             Height="80"/>

                    <Button Content="🖼️ Choisir une image"
                            Command="{Binding SelectFilesCommand}"
                            Classes="OutlineGray"
                            Margin="0,5,0,0"/>
                    
                    <Border BorderBrush="#34495E" 
                            BorderThickness="2" 
                            CornerRadius="8" 
                            Padding="4"
                            Background="White">
                        <Image Source="{Binding Picture}"
                               Height="100"
                               MaxHeight="100"
                               Stretch="UniformToFill" />
                    </Border>
                    
                    <TextBlock Text="{Binding SelectedFiles[0]}"
                               FontSize="11"
                               Foreground="#7F8C8D"
                               TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*" 
                          ColumnSpacing="10"
                          Margin="0,15,0,5">
                        
                        <Button Grid.Column="0"
                                Content="💾 Enregistrer"
                                Command="{Binding SaveChangesCommand}"
                                Classes="OutlineGreen"
                                Padding="12,8"/>
                        
                        <Button Grid.Column="1"
                                Content="❌ Annuler"
                                Command="{Binding CancelCommand}"
                                Classes="OutlineRed"
                                Padding="12,8"/>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>