<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartoonCharacters.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CartoonCharacters.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CartoonCharacters.Views.CollectionEditView"
             x:DataType="viewModels:CollectionEditViewModel"
             Background="#2C3E50">

    <UserControl.Styles>
        <!-- Style pour tous les TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- Style pour TextBox en focus -->
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#7289DA"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Style pour les Watermark -->
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#999999"/>
        </Style>
        
        <!-- Style pour les boutons encadrés -->
        <Style Selector="Button.encadre">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.encadre:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="20">
        
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Margin="0,0,0,20">
            
            <Border Background="#36393F"
                    BorderBrush="#7289DA"
                    BorderThickness="3"
                    CornerRadius="8"
                    Padding="20"
                    Margin="10"
                    Width="400">

                <StackPanel Spacing="12">

                    <!-- Titre en français -->
                    <TextBlock Text="✏️ Modifier le personnage"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="18"
                               Foreground="White"
                               Margin="0,0,0,10"/>

                    <!-- Nom en français -->
                    <TextBlock Text="📝 Nom :" 
                               Foreground="#E0E0E0" 
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="ex: Homer Simpson"
                             Text="{Binding Name}"/>

                    <!-- Description en français -->
                    <TextBlock Text="📖 Description :" 
                               Foreground="#E0E0E0" 
                               Margin="0,5,0,0"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="ex: Aime les donuts..."
                             Text="{Binding Description}"
                             AcceptsReturn="True"
                             Height="80"/>

                    <!-- Bouton Select Image en français -->
                    <Button Content="🖼️ Choisir une image"
                            Command="{Binding SelectFilesCommand}"
                            Background="#4E5D94"
                            BorderBrush="#3A4A7A"
                            Foreground="White"
                            CornerRadius="5"
                            Padding="10,5"
                            Margin="0,5,0,0"/>
                    
                    <Border BorderBrush="#7289DA" 
                            BorderThickness="2" 
                            CornerRadius="5" 
                            Padding="4"
                            Background="White">
                        <Image Source="{Binding Picture}"
                               Height="100"
                               MaxHeight="100"
                               Stretch="UniformToFill" />
                    </Border>
                    
                    <TextBlock Text="{Binding SelectedFiles[0]}"
                               FontSize="11"
                               Foreground="#CCCCCC"
                               Opacity="0.9"
                               TextWrapping="Wrap"/>

                    <!-- Boutons d'action encadrés -->
                    <Grid ColumnDefinitions="*,*,*" 
                          Margin="0,15,0,5">
                        
                        <!-- Bouton Enregistrer - encadré vert -->
                        <Button Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Content="💾 Enregistrer"
                                Command="{Binding SaveChangesCommand}"
                                Classes="encadre"
                                BorderBrush="#43B581"
                                Foreground="#43B581"
                                CornerRadius="5"
                                Padding="12,8"
                                Margin="0,0,5,0">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#3343B581"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        
                        <!-- Bouton Annuler - encadré rouge -->
                        <Button Grid.Column="2"
                                Content="❌ Annuler"
                                Command="{Binding CancelCommand}"
                                Classes="encadre"
                                BorderBrush="#F04747"
                                Foreground="#F04747"
                                CornerRadius="5"
                                Padding="12,8"
                                Margin="5,0,0,0">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#33F04747"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>

                    <!-- Espace supplémentaire en bas pour le scrolling -->
                    <Border Height="10" Opacity="0"/>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>