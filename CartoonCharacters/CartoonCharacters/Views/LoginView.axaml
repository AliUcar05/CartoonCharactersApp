<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CartoonCharacters.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:Class="CartoonCharacters.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             x:Name="LoginRoot"
             Background="#2C3E50">

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#95A5A6"/>
        </Style>
        
        <Style Selector="Button.OutlineGreen">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineGreen:pointerover">
            <Setter Property="Background" Value="#27AE6010"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
        </Style>
        
        <Style Selector="Button.OutlineBlue">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#3498DB"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style Selector="Button.OutlineBlue:pointerover">
            <Setter Property="Background" Value="#3498DB10"/>
            <Setter Property="BorderBrush" Value="#5DADE2"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Background="#2C3E50"
                CornerRadius="12"
                BorderBrush="#34495E"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <Border Background="#36393F"
                    CornerRadius="12"
                    Padding="30"
                    Width="380">

                <StackPanel Spacing="16">

                    <TextBlock Text="🔐 Connexion"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Connectez-vous pour accéder à l'application"
                               FontSize="12"
                               Foreground="#BDC3C7"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Nom d'utilisateur"
                                   FontWeight="SemiBold"
                                   Foreground="#ECF0F1"
                                   FontSize="12"/>
                        <TextBox Text="{Binding Username}"
                                 Watermark="Entrez votre nom d'utilisateur"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Mot de passe"
                                   FontWeight="SemiBold"
                                   Foreground="#ECF0F1"
                                   FontSize="12"/>
                        <TextBox Text="{Binding Password}"
                                 Watermark="Entrez votre mot de passe"
                                 PasswordChar="•"/>
                    </StackPanel>

                    <Button Content="Se connecter"
                            Command="{Binding LoginCommand}"
                            Classes="OutlineGreen"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="4"
                                Margin="0,10,0,0">

                        <TextBlock Text="Pas encore inscrit ?"
                                   Foreground="#95A5A6"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>

                        <Button Content="S'inscrire"
                                Command="{Binding GoToRegisterCommand}"
                                Classes="OutlineBlue"
                                Padding="8,4"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>