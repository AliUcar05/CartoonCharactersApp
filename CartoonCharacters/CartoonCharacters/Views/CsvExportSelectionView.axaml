<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CartoonCharacters.ViewModels"
             xmlns:converters="clr-namespace:CartoonCharacters.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="CartoonCharacters.Views.CsvExportSelectionView"
             x:DataType="vm:CsvExportSelectionViewModel"
             Background="#2C3E50">

    <UserControl.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="15" RowSpacing="10">

        <!-- En-tête -->
        <Border Grid.Row="0"
                Background="#36393F"
                CornerRadius="6"
                Padding="12">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                <!-- Titre -->
                <TextBlock Grid.Column="0"
                           Text="📤 Exporter des personnages"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <!-- Tout sélectionner -->
                <Border Grid.Column="2"
                        Background="#2C3E50"
                        CornerRadius="4"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <CheckBox IsChecked="{Binding AllSelected}"
                                  Content="Tout"
                                  Foreground="White"
                                  FontSize="11"/>
                        <TextBlock Text="("
                                   Foreground="#7F8C8D"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCount}"
                                   Foreground="#3498DB"
                                   FontWeight="Bold"
                                   FontSize="11"/>
                        <TextBlock Text=")"
                                   Foreground="#7F8C8D"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Liste des personnages -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10" Spacing="6">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExportItem">
                            <Border Background="#34495E"
                                    BorderBrush="#2C3E50"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Padding="10"
                                    Margin="0,0,0,5">

                                <StackPanel Orientation="Horizontal">
                                    <!-- Image -->
                                    <Panel>
                                        <Rectangle Height="100" Width="100" Fill="LightGray"/>
                                        <Image Margin="20"
                                               Height="200"
                                               Width="200"
                                               Stretch="UniformToFill"
                                               Source="{Binding Character.ImagePath, Converter={StaticResource PathToBitmapConverter}}"/>
                                    </Panel>

                                    <!-- Infos -->
                                    <StackPanel Orientation="Vertical"
                                                Margin="10,0,0,0"
                                                Spacing="5"
                                                Width="520">

                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Character.Name}"
                                                  Foreground="White"
                                                  FontWeight="Bold"
                                                  FontSize="14"/>

                                        <TextBlock Text="{Binding Character.Description}"
                                                   Foreground="#BDC3C7"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,4"/>

                                        <!-- Rating affiché avant export -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="14"
                                                    Margin="0,2,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="★"
                                                           Foreground="Gold"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Character.Rating, StringFormat=Note moyenne : {0:F1}/5}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Character.RatingVotes, StringFormat=Votes : {0}}"
                                                       Foreground="#BDC3C7"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons d'action -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="#36393F"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                <TextBlock Grid.Column="0"
                           Foreground="#BDC3C7"
                           FontSize="11"
                           VerticalAlignment="Center">
                    <Run Text="{Binding SelectedCount}"/>
                    <Run Text=" sélectionné(s)"/>
                </TextBlock>

                <Button Grid.Column="1"
                        Content="❌ Annuler"
                        Command="{Binding CancelExportCommand}"
                        Background="Transparent"
                        BorderBrush="#F04747"
                        BorderThickness="2"
                        Foreground="#F04747"
                        Padding="15,8"
                        FontSize="12"
                        CornerRadius="4"
                        Margin="0,0,3,0">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#33F04747"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <Button Grid.Column="2"
                        Content="📤 Exporter"
                        Command="{Binding ConfirmExportCommand}"
                        Background="Transparent"
                        BorderBrush="#43B581"
                        BorderThickness="2"
                        Foreground="#43B581"
                        Padding="15,8"
                        FontSize="12"
                        CornerRadius="4">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#3343B581"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>