<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CartoonCharacters.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CartoonCharacters.Views.CollectionView"
             x:DataType="viewModels:CollectionViewModel"
             x:Name="Collection">

  <Design.DataContext>
    <viewModels:CollectionViewModel/>
  </Design.DataContext>

  <DockPanel Margin="20">
    <Border Background="AliceBlue">
      <ScrollViewer>
        <ListBox x:Name="Animals"
                 ItemsSource="{Binding MyObservableCartoonCharacters}"
                 SelectedItem="{Binding SelectedCartoonCharacter}"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="Gainsboro"
                      BorderBrush="Black"
                      BorderThickness="2"
                      CornerRadius="3"
                      Padding="10"
                      Margin="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                  <Panel Grid.Column="0">
                    <Rectangle Height="100" Width="100" Fill="LightGray"/>
                    <Image Margin="20"
                           Height="200"
                           Width="200"
                           Stretch="UniformToFill"
                           Source="{Binding ImagePath, Converter={StaticResource PathToBitmapConverter}}"/>
                  </Panel>

                  <StackPanel Grid.Column="1"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name, StringFormat=Nom : {0}}"
                               Foreground="Black"/>
                    <TextBlock Text="{Binding Description, StringFormat=Description : {0}}"
                               Foreground="Black"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Spacing="8">

                    <!-- Bouton Action existant -->
                    <Button Content="Action"
                            Foreground="Black"
                            Command="{Binding DataContext.FromParentCommand, ElementName=Collection}"
                            CommandParameter="{Binding Id}"
                            Padding="10,5"/>

                    <!-- NOUVEAU Bouton Modifier -->
                    <Button Content="Modifier"
                            Foreground="White"
                            Background="#4E5D94"
                            BorderBrush="#3A4A7A"
                            Command="{Binding DataContext.EditCommand, ElementName=Collection}"
                            CommandParameter="{Binding Id}"
                            Padding="10,5"/>

                    <!-- NOUVEAU Bouton Suppression -->
                    <Button Content="Supprimer"
                            Foreground="White"
                            Background="#C84B4B"
                            BorderBrush="#A63A3A"
                            Command="{Binding DataContext.DeleteCommand, ElementName=Collection}"
                            CommandParameter="{Binding Id}"
                            Padding="10,5"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>