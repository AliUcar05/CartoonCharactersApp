<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CartoonCharacters.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:converters="clr-namespace:CartoonCharacters.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CartoonCharacters.Views.CollectionView"
             x:DataType="viewModels:CollectionViewModel"
             x:Name="Collection">

  <Design.DataContext>
    <viewModels:CollectionViewModel/>
  </Design.DataContext>

  <UserControl.Resources>
    <converters:IsAllCollectionsFilterConverter x:Key="IsAllCollectionsFilterConverter"/>
    <converters:CanEditConverter x:Key="CanEditConverter"/>
    <converters:SortOptionToStringConverter x:Key="SortOptionToStringConverter"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Style unifié pour les ComboBox -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#2C3E50"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#34495E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Height" Value="34"/>
    </Style>
    
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#2C3E50"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="#3498DB"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="#2C3E50"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Contenu principal -->
    <DockPanel Margin="20" LastChildFill="True">
      
      <!-- Barre d'outils -->
      <Border DockPanel.Dock="Top"
              Background="Transparent"
              Margin="0,0,0,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          
          <!-- Partie gauche : Filtre -->
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="12"
                      VerticalAlignment="Center">
            <TextBlock Text="Afficher :"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="White"
                       FontSize="13"/>
            <ComboBox Width="220"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
          </StackPanel>

          <!-- Espace central -->
          <StackPanel Grid.Column="1"/>

          <!-- Partie droite : Tri -->
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="12"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            
            <TextBlock Text="Trier par :"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="White"
                       FontSize="13"/>
            <ComboBox Width="220"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource SortOptionToStringConverter}}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            
            <!-- Bouton Top 5 -->
            <Button Content="🏆 Top 5 des mieux notés"
                    Command="{Binding ShowTop5Command}"
                    IsVisible="{Binding SelectedFilter, Converter={StaticResource IsAllCollectionsFilterConverter}}"
                    Background="Transparent"
                    BorderBrush="#F39C12"
                    BorderThickness="1.5"
                    CornerRadius="6"
                    Foreground="#F39C12"
                    Padding="12,6"
                    FontWeight="SemiBold"
                    Cursor="Hand">
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Background" Value="#F39C1210"/>
                  <Setter Property="BorderBrush" Value="#F1C40F"/>
                  <Setter Property="Foreground" Value="#F1C40F"/>
                </Style>
              </Button.Styles>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Liste des collections - Fond élégant comme le header -->
      <Border Background="#2C3E50"
              CornerRadius="8"
              Padding="1">
        <ScrollViewer>
          <ListBox x:Name="Animals"
                   ItemsSource="{Binding FilteredCartoonCharacters}"
                   SelectedItem="{Binding SelectedCartoonCharacter}"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   Background="#2C3E50"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- Carte personnage -->
                <Border Background="#34495E"
                        BorderBrush="#3D566E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="10"
                        Cursor="Hand">
                  <Grid RowDefinitions="Auto,Auto"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="15"
                        RowSpacing="10">
                    
                    <!-- Image -->
                    <Panel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
                      <Border Height="120" 
                              Width="120" 
                              Background="#2C3E50" 
                              CornerRadius="8"/>
                      <Image Margin="20"
                             Height="180"
                             Width="180"
                             Stretch="UniformToFill"
                             Source="{Binding ImagePath, Converter={StaticResource PathToBitmapConverter}}"/>
                    </Panel>
                    
                    <!-- Boutons d'action -->
                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          ColumnDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="10"
                          Margin="0,0,0,5">
                      
                      <!-- Bouton Action (outline gris) -->
                      <Button Grid.Column="0"
                              Content="⚡ Action"
                              Command="{Binding DataContext.FromParentCommand, ElementName=Collection}"
                              CommandParameter="{Binding Id}"
                              Padding="10,5"
                              FontSize="11"
                              MinWidth="80"
                              Background="Transparent"
                              BorderBrush="#7F8C8D"
                              BorderThickness="1.5"
                              CornerRadius="6"
                              Foreground="#BDC3C7"
                              Cursor="Hand">
                        <Button.Styles>
                          <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#7F8C8D10"/>
                            <Setter Property="BorderBrush" Value="#95A5A6"/>
                          </Style>
                        </Button.Styles>
                      </Button>
                      
                      <!-- Bouton Modifier (outline vert) -->
                      <Button Grid.Column="1"
                              Content="✎ Modifier"
                              Command="{Binding DataContext.EditCommand, ElementName=Collection}"
                              CommandParameter="{Binding Id}"
                              Padding="10,5"
                              FontSize="11"
                              MinWidth="80"
                              Background="Transparent"
                              BorderBrush="#27AE60"
                              BorderThickness="1.5"
                              CornerRadius="6"
                              Foreground="#2ECC71"
                              Cursor="Hand">
                        <Button.IsVisible>
                          <MultiBinding Converter="{StaticResource CanEditConverter}">
                            <Binding Path="DataContext" ElementName="Collection"/>
                            <Binding Path="Id"/>
                          </MultiBinding>
                        </Button.IsVisible>
                        <Button.Styles>
                          <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#27AE6010"/>
                            <Setter Property="BorderBrush" Value="#2ECC71"/>
                          </Style>
                        </Button.Styles>
                      </Button>
                      
                      <!-- Bouton Supprimer (outline rouge) -->
                      <Button Grid.Column="2"
                              Content="🗑 Supprimer"
                              Padding="10,5"
                              FontSize="11"
                              MinWidth="80"
                              Background="Transparent"
                              BorderBrush="#E74C3C"
                              BorderThickness="1.5"
                              CornerRadius="6"
                              Foreground="#EC7063"
                              Cursor="Hand">
                        <Button.IsVisible>
                          <MultiBinding Converter="{StaticResource CanEditConverter}">
                            <Binding Path="DataContext" ElementName="Collection"/>
                            <Binding Path="Id"/>
                          </MultiBinding>
                        </Button.IsVisible>
                        <Button.Styles>
                          <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#E74C3C10"/>
                            <Setter Property="BorderBrush" Value="#EC7063"/>
                          </Style>
                        </Button.Styles>
                        <Button.Flyout>
                          <Flyout Placement="Bottom">
                            <Border Background="#2C3E50"
                                    CornerRadius="8"
                                    Padding="12">
                              <StackPanel Width="260" Spacing="12">
                                <TextBlock Text="Confirmer la suppression"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="White"/>
                                <TextBlock Text="{Binding Name, StringFormat=Tu vas supprimer : {0}}"
                                           TextWrapping="Wrap"
                                           Foreground="#BDC3C7"/>
                                <TextBlock Text="Cette action est irréversible."
                                           Foreground="#E74C3C"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <Button Content="Oui, supprimer"
                                        Background="Transparent"
                                        BorderBrush="#E74C3C"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Foreground="#EC7063"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=Collection}"
                                        CommandParameter="{Binding Id}"
                                        Padding="10,6"
                                        Cursor="Hand">
                                  <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                      <Setter Property="Background" Value="#E74C3C10"/>
                                    </Style>
                                  </Button.Styles>
                                </Button>
                              </StackPanel>
                            </Border>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      
                      <!-- Note -->
                      <StackPanel Grid.Column="3"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Spacing="4">
                        <TextBlock Text="★"
                                   Foreground="#F39C12"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"
                                   Foreground="#F39C12"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    
                    <!-- Informations personnage -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Top">
                      <TextBlock Text="{Binding Name, StringFormat=Nom : {0}}"
                                 Foreground="#ECF0F1"
                                 FontWeight="Bold"
                                 FontSize="14"/>
                      <TextBlock Text="{Binding Description, StringFormat=Description : {0}}"
                                 Foreground="#BDC3C7"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <!-- Dialogue Top 5 -->
    <Panel IsVisible="{Binding IsTop5DialogOpen}">
      <Border Background="#CC000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2C3E50"
                CornerRadius="16"
                Padding="25"
                MaxWidth="700"
                MinWidth="600">
          <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="🏆 TOP 5 DES MIEUX NOTÉS"
                         FontSize="20"
                         FontWeight="Bold"
                         Foreground="#F39C12"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="✕"
                      Background="Transparent"
                      Foreground="#E74C3C"
                      FontWeight="Bold"
                      Command="{Binding CloseTop5Dialog}"
                      FontSize="18"
                      Cursor="Hand"
                      BorderThickness="0">
                <Button.Styles>
                  <Style Selector="Button:pointerover">
                    <Setter Property="Foreground" Value="#EC7063"/>
                  </Style>
                </Button.Styles>
              </Button>
            </Grid>

            <Border Background="#34495E"
                    CornerRadius="12"
                    Padding="15">
              <lvc:CartesianChart Series="{Binding Top5Series}"
                                  XAxes="{Binding Top5XAxes}"
                                  YAxes="{Binding Top5YAxes}"
                                  Height="400"
                                  MinWidth="550"
                                  Background="#34495E"/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="30">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="20" Height="20" Background="#F39C12" CornerRadius="4"/>
                <TextBlock Text="Note moyenne" FontSize="12" Foreground="#BDC3C7"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⭐" FontSize="14" Foreground="#F39C12"/>
                <TextBlock Text="Maximum = 5.0" FontSize="12" Foreground="#BDC3C7"/>
              </StackPanel>
            </StackPanel>

            <Button Content="Fermer"
                    Command="{Binding CloseTop5Dialog}"
                    HorizontalAlignment="Center"
                    Width="140"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="#3498DB"
                    BorderThickness="1.5"
                    Foreground="#5DADE2"
                    FontWeight="SemiBold"
                    Cursor="Hand">
              <Button.Styles>
                <Style Selector="Button:pointerover">
                  <Setter Property="Background" Value="#3498DB10"/>
                  <Setter Property="BorderBrush" Value="#5DADE2"/>
                </Style>
              </Button.Styles>
            </Button>
          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </Grid>
</UserControl>