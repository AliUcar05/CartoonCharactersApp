<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CartoonCharacters.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="CartoonCharacters.Views.CollectionView"
             x:DataType="viewModels:CollectionViewModel"
             x:Name="Collection">

  <Design.DataContext>
    <viewModels:CollectionViewModel/>
  </Design.DataContext>

  <DockPanel Margin="20">
    <Border Background="AliceBlue">
      <ScrollViewer>
        <ListBox x:Name="Animals"
                 ItemsSource="{Binding FilteredCartoonCharacters}"
                 SelectedItem="{Binding SelectedCartoonCharacter}"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="Gainsboro"
                      BorderBrush="#2C3E50"
                      BorderThickness="2"
                      CornerRadius="3"
                      Padding="10"
                      Margin="10">
                
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="15"
                      RowSpacing="10">

                  <!-- Image -->
                  <Panel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
                    <Rectangle Height="100" Width="100" Fill="LightGray"/>
                    <Image Margin="20"
                           Height="200"
                           Width="200"
                           Stretch="UniformToFill"
                           Source="{Binding ImagePath, Converter={StaticResource PathToBitmapConverter}}"/>
                  </Panel>

                  <!-- Ligne boutons + note -->
                  <Grid Grid.Row="0"
                        Grid.Column="1"
                        ColumnDefinitions="Auto,Auto,Auto,*"
                        ColumnSpacing="8"
                        Margin="0,0,0,5">

                    <Button Grid.Column="0"
                            Content="⚡ Action"
                            Foreground="Black"
                            Background="LightGray"
                            BorderBrush="Gray"
                            Command="{Binding DataContext.FromParentCommand, ElementName=Collection}"
                            CommandParameter="{Binding Id}"
                            Padding="8,4"
                            FontSize="11"
                            MinWidth="70"/>

                    <Button Grid.Column="1"
                            Content="✎ Modifier"
                            Foreground="White"
                            Background="#4E5D94"
                            BorderBrush="#3A4A7A"
                            Command="{Binding DataContext.EditCommand, ElementName=Collection}"
                            CommandParameter="{Binding Id}"
                            Padding="8,4"
                            FontSize="11"
                            MinWidth="70"/>

                    <Button Grid.Column="2"
                            Content="🗑 Supprimer"
                            Foreground="White"
                            Background="#C84B4B"
                            BorderBrush="#A63A3A"
                            Command="{Binding DataContext.DeleteCommand, ElementName=Collection}"
                            CommandParameter="{Binding Id}"
                            Padding="8,4"
                            FontSize="11"
                            MinWidth="70"/>

                    <!-- Note à droite, sans encadré -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Margin="12,0,0,0">
                      <TextBlock Text="★"
                                 Foreground="Gold"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"
                                 Foreground="Black"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>

                  <!-- Infos -->
                  <StackPanel Grid.Row="1"
                              Grid.Column="1"
                              VerticalAlignment="Top">
                    <TextBlock Text="{Binding Name, StringFormat=Nom : {0}}"
                               Foreground="#2C3E50"
                               FontWeight="Bold"
                               FontSize="15"/>
                    <TextBlock Text="{Binding Description, StringFormat=Description : {0}}"
                               Foreground="#2C3E50"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>