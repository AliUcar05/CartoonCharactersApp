<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CartoonCharacters.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="550"
             x:Class="CartoonCharacters.Views.CollectionDetailsView"
             x:DataType="viewModels:CollectionDetailsViewModel">

    <Design.DataContext>
        <viewModels:CollectionDetailsViewModel/>
    </Design.DataContext>

    <Grid Margin="15">
        <Border Background="#34495E"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="6"
                Padding="20">

            <Grid RowDefinitions="Auto,Auto,*"
                  RowSpacing="14">

                <!-- TITRE GLOBAL -->
                <TextBlock Grid.Row="0"
                           Text="{Binding MyCartoonCharacter.Name, StringFormat=Voici les caractéristiques de {0} :}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- LIGNE BLANCHE FINE -->
                <Border Grid.Row="1"
                        Height="1"
                        Background="White"
                        Opacity="0.85"
                        Margin="0,2,0,4"/>

                <!-- TABLEAU 3 COLONNES -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="270,1,340,1,*"
                      ColumnSpacing="18">

                    <!-- COLONNE 1 : PHOTO -->
                    <Grid Grid.Column="0"
                          VerticalAlignment="Top">
                        <Border Background="#2C3E50"
                                BorderBrush="#5D6D7E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Width="250"
                                Height="290"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                            <Grid>
                                <Rectangle Fill="LightGray"/>
                                <Image Source="{Binding MyCartoonCharacter.ImagePath, Converter={StaticResource PathToBitmapConverter}}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SÉPARATEUR VERTICAL 1 -->
                    <Border Grid.Column="1"
                            Width="1"
                            Background="White"
                            Opacity="0.55"
                            Margin="0,6"/>

                    <!-- COLONNE 2 : SCORE -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Stretch"
                                Spacing="14">

                        <TextBlock Text="Score"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <Border Background="#2C3E50"
                                BorderBrush="#5D6D7E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                MinHeight="230">
                            <StackPanel Spacing="18"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="Donne ta note :"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="6">
                                    <Button Content="★"
                                            Command="{Binding Rate1Command}"
                                            Foreground="{Binding Star1Brush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Width="44"
                                            Height="44"/>

                                    <Button Content="★"
                                            Command="{Binding Rate2Command}"
                                            Foreground="{Binding Star2Brush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Width="44"
                                            Height="44"/>

                                    <Button Content="★"
                                            Command="{Binding Rate3Command}"
                                            Foreground="{Binding Star3Brush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Width="44"
                                            Height="44"/>

                                    <Button Content="★"
                                            Command="{Binding Rate4Command}"
                                            Foreground="{Binding Star4Brush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Width="44"
                                            Height="44"/>

                                    <Button Content="★"
                                            Command="{Binding Rate5Command}"
                                            Foreground="{Binding Star5Brush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Width="44"
                                            Height="44"/>
                                </StackPanel>

                                <Border Height="1"
                                        Background="White"
                                        Opacity="0.35"/>

                                <StackPanel Spacing="10"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MyCartoonCharacter.Rating, StringFormat=Note moyenne : {0:F1}/5}"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>

                                    <TextBlock Text="{Binding MyCartoonCharacter.RatingVotes, StringFormat=Nombre de votes : {0}}"
                                               Foreground="#D5DBDB"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SÉPARATEUR VERTICAL 2 -->
                    <Border Grid.Column="3"
                            Width="1"
                            Background="White"
                            Opacity="0.55"
                            Margin="0,6"/>

                    <!-- COLONNE 3 : DESCRIPTION -->
                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Top"
                                Spacing="14">

                        <TextBlock Text="Description"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Border Background="#2C3E50"
                                BorderBrush="#5D6D7E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                MinHeight="230">
                            <TextBlock Text="{Binding MyCartoonCharacter.Description}"
                                       Foreground="White"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>