<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CartoonCharacters.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:Class="CartoonCharacters.Views.RegisterView"
             x:DataType="vm:RegisterViewModel"
             x:Name="RegisterRoot"
             Background="#2C3E50">

    <Design.DataContext>
        <vm:RegisterViewModel/>
    </Design.DataContext>

    <Grid>
        <Border Width="380"
                Padding="30"
                CornerRadius="12"
                Background="AliceBlue"
                BorderBrush="#1F2D3A"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">

                    <TextBlock Text="Inscription"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Créez votre compte pour accéder à l'application"
                               FontSize="13"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Nom d'utilisateur"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"/>
                        <TextBox Text="{Binding UserName}"
                                 Watermark="Entrez votre nom d'utilisateur"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#B0BEC5"
                                 Padding="10"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="Prénom"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"/>
                        <TextBox Text="{Binding FirstName}"
                                 Watermark="Entrez votre prénom"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#B0BEC5"
                                 Padding="10"/>
                    </StackPanel>
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="Nom"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"/>
                        <TextBox Text="{Binding LastName}"
                                 Watermark="Entrez votre nom"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#B0BEC5"
                                 Padding="10"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="E-mail"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"/>
                        <TextBox Text="{Binding Email}"
                                 Watermark="Entrez votre e-mail"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#B0BEC5"
                                 Padding="10"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Mot de passe"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"/>
                        <TextBox Text="{Binding Password}"
                                 Watermark="Entrez votre mot de passe"
                                 PasswordChar="•"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#B0BEC5"
                                 Padding="10"/>
                    </StackPanel>

                    <Button Content="S'inscrire"
                            Command="{Binding RegisterCommand}"
                            Background="#4E5D94"
                            Foreground="White"
                            BorderBrush="#3A4A7A"
                            FontWeight="Bold"
                            Padding="12"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="4"
                                Margin="0,10,0,0">

                        <TextBlock Text="Vous avez déjà un compte ?"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"/>

                        <Button Content="Se connecter"
                                Command="{Binding GoToLoginCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Foreground="#4E5D94"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>