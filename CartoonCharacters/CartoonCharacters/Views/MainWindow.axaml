<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartoonCharacters.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="CartoonCharacters.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cartoon Characters Collection"
        Background="#F5F5F5">

    <Grid RowDefinitions="80,80,*">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                BorderBrush="#34495E"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="Cartoon Characters Collection"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="Segoe UI, Arial, sans-serif"
                           LetterSpacing="0.5"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Version}"
                           Foreground="#BDC3C7"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Zone QR Code -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D5DBDB"
                BorderThickness="0,0,0,1"
                Padding="15"
                Margin="10,10,10,0"
                CornerRadius="8">
            <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
                <Border Grid.Column="0"
                        Background="#27AE60"
                        CornerRadius="8"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <TextBlock Text="QR Code scanné"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1"
                        Background="#ECF0F1"
                        BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <TextBlock Text="{Binding QrCode}"
                               Foreground="#2C3E50"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Contenu principal avec menu horizontal -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto,*"
              Margin="10">
            
            <!-- Barre de navigation avec boutons à gauche et login à droite -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*, Auto"
                  Margin="0,0,0,10">
                
                <!-- Boutons de navigation à gauche -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8">
                    
                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding BackToMainCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="12"/>
                            <TextBlock Text="Accueil"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding GoToAddCartoonCharactersCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="12"/>
                            <TextBlock Text="Ajouter"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- NOUVEAU : Bouton Importer CSV -->
                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding ImportCsvCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📥" FontSize="12"/>
                            <TextBlock Text="Importer"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- NOUVEAU : Bouton Exporter CSV -->
                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding ExportCsvCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📤" FontSize="12"/>
                            <TextBlock Text="Exporter"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bouton Login à droite -->
                <Button Grid.Column="1"
                        Background="#2C3E50"
                        Foreground="White"
                        BorderBrush="#34495E"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8,6"
                        Cursor="Hand">
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="3"
                                HorizontalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="12"/>
                        <TextBlock Text="Login"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Zone de contenu -->
            <Border Grid.Row="1"
                    Background="#2C3E50"
                    CornerRadius="8"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>