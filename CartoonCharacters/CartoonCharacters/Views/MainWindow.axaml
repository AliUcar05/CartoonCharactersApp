<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartoonCharacters.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="600"
        x:Class="CartoonCharacters.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cartoon Characters Collection"
        Background="#F5F5F5">

    <Grid RowDefinitions="80,*">
        <Border Grid.Row="0"
                Background="#2C3E50"
                BorderBrush="#34495E"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <!-- Titre principal -->
                <TextBlock Text="Cartoon Characters Collection"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="Segoe UI, Arial, sans-serif"
                           LetterSpacing="0.5"
                           HorizontalAlignment="Center"/>

                <!-- Séparateur décoratif -->
                <Border Height="1"
                        Width="200"
                        Background="#34495E"
                        Margin="0,4,0,4"
                        IsVisible="{Binding IsUserLoggedIn}"/>

                <!-- Ligne d'accueil personnalisée -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding IsUserLoggedIn}">
                    <TextBlock Text="✨"
                               Foreground="#FFD700"
                               FontSize="11"/>
                    <TextBlock Text="{Binding CurrentUser.FirstName}"
                               Foreground="#FFD700"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="·"
                               Foreground="#7F8C8D"
                               FontSize="11"/>
                    <TextBlock Text="{Binding Version}"
                               Foreground="#7F8C8D"
                               FontSize="11"/>
                    <TextBlock Text="✨"
                               Foreground="#FFD700"
                               FontSize="11"/>
                </StackPanel>
                
                <!-- Version seule quand non connecté -->
                <TextBlock Text="{Binding Version}"
                           Foreground="#BDC3C7"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding !IsUserLoggedIn}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Margin="10">

            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0,0,0,10"
                  IsVisible="{Binding ShowNavigationBar}">

                <!-- Boutons de navigation à gauche - Design avec contour -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="12">

                    <Button Command="{Binding BackToMainCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#3498DB"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="10,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#3498DB10"/>
                                <Setter Property="BorderBrush" Value="#5DADE2"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="12"/>
                            <TextBlock Text="Accueil"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#3498DB"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding GoToAddCartoonCharactersCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#27AE60"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="10,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#27AE6010"/>
                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="12"/>
                            <TextBlock Text="Ajouter"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#27AE60"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportCsvCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#E67E22"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="10,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#E67E2210"/>
                                <Setter Property="BorderBrush" Value="#F39C12"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📥" FontSize="12"/>
                            <TextBlock Text="Importer"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#E67E22"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCsvCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#8E44AD"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="10,6">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#8E44AD10"/>
                                <Setter Property="BorderBrush" Value="#9B59B6"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📤" FontSize="12"/>
                            <TextBlock Text="Exporter"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#8E44AD"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Barre de recherche au centre -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="4"
                        Margin="15,0"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="8,0,4,0"
                                   Foreground="#7F8C8D"/>

                        <TextBox Grid.Column="1"
                                 Name="SearchTextBox"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Rechercher un personnage par nom..."
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Padding="4,6"
                                 Foreground="#2C3E50"
                                 CaretBrush="#2C3E50"/>

                        <Button Grid.Column="2"
                                Content="✖"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Foreground="#95A5A6"
                                Cursor="Hand"
                                Padding="4,2"
                                IsVisible="{Binding HasSearchText}"/>
                    </Grid>
                </Border>

                <!-- Bouton Profile à droite avec menu intégré -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    
                    <Button Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#3498DB"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Padding="12,6"
                            IsVisible="{Binding IsUserLoggedIn}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#3498DB10"/>
                                <Setter Property="BorderBrush" Value="#5DADE2"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="👤"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding CurrentUser.UserName}"
                                       Foreground="#3498DB"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="▼"
                                       Foreground="#7F8C8D"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Background="White"
                                        BorderBrush="#D0D7DE"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        MinWidth="160">
                                    <StackPanel Spacing="4">
                                        
                                        <!-- Admin option (visible seulement pour admin) -->
                                        <Button Command="{Binding GoToAdminUsersCommand}"
                                                IsVisible="{Binding IsCurrentUserAdmin}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                Padding="12,8"
                                                CornerRadius="6">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#8E44AD10"/>
                                                </Style>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#8E44AD10"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="🛠" FontSize="13"/>
                                                <TextBlock Text="Administration"
                                                           Foreground="#8E44AD"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Séparateur pour admin -->
                                        <Border Height="1"
                                                Background="#ECF0F1"
                                                Margin="8,4"
                                                IsVisible="{Binding IsCurrentUserAdmin}"/>

                                        <!-- Déconnexion -->
                                        <Button Command="{Binding LogoutCommand}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                Padding="12,8"
                                                CornerRadius="6">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#E74C3C10"/>
                                                </Style>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="#E74C3C10"/>
                                                </Style>
                                            </Button.Styles>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="🚪" FontSize="13"/>
                                                <TextBlock Text="Déconnexion"
                                                           Foreground="#E74C3C"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#2C3E50"
                    CornerRadius="8"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>