<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartoonCharacters.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CartoonCharacters.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cartoon Characters Collection"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    
    <Grid RowDefinitions="70,*">
        <!-- Header - Version info -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                BorderBrush="#34495E" 
                BorderThickness="0,0,0,1" 
                Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=Version}" 
                          Foreground="#ECF0F1"
                          FontSize="14"
                          FontWeight="SemiBold"/>
                <TextBlock Text="{Binding QrCode}"></TextBlock>
            </StackPanel>
        </Border>
        
        <!-- Main content area -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*" Margin="10">
            <!-- Navigation sidebar -->
            <Border Grid.Column="0" 
                    Background="#34495E" 
                    CornerRadius="8" 
                    Padding="10" 
                    Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="8">
                    <TextBlock Text="Navigation" 
                              Foreground="#ECF0F1"
                              FontSize="16"
                              FontWeight="Bold"
                              Margin="0,0,0,10"/>
                    
                    <Button Background="#3498DB"
                            Foreground="White"
                            BorderBrush="#2980B9"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            HorizontalContentAlignment="Center"
                            Command="{Binding BackToMainCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="16"/>
                            <TextBlock Text="Accueil" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Background="#27AE60"
                            Foreground="White"
                            BorderBrush="#229954"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            HorizontalContentAlignment="Center"
                            Command="{Binding Path=GoToAddCartoonCharactersCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="16"/>
                            <TextBlock Text="Ajouter" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Content area -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="8" 
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>