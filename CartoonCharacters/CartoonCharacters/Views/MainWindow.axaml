<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartoonCharacters.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="CartoonCharacters.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cartoon Characters Collection"
        Background="#F5F5F5">

    <Grid RowDefinitions="80,Auto,*">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                BorderBrush="#34495E"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="Cartoon Characters Collection"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="Segoe UI, Arial, sans-serif"
                           LetterSpacing="0.5"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Version}"
                           Foreground="#BDC3C7"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Zone QR Code -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D5DBDB"
                BorderThickness="0,0,0,1"
                Padding="15"
                Margin="10,10,10,0"
                CornerRadius="8">
            <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
                <Border Grid.Column="0"
                        Background="#27AE60"
                        CornerRadius="8"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <TextBlock Text="QR Code scanné"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1"
                        Background="#ECF0F1"
                        BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <TextBlock Text="{Binding QrCode}"
                               Foreground="#2C3E50"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Row="2"
              ColumnDefinitions="220,*"
              Margin="10">
            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#34495E"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Spacing="8">
                    <TextBlock Text="Navigation"
                               Foreground="#ECF0F1"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Button Background="#3498DB"
                            Foreground="White"
                            BorderBrush="#2980B9"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            HorizontalContentAlignment="Center"
                            Command="{Binding BackToMainCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="16"/>
                            <TextBlock Text="Accueil"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#27AE60"
                            Foreground="White"
                            BorderBrush="#229954"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            HorizontalContentAlignment="Center"
                            Command="{Binding GoToAddCartoonCharactersCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="16"/>
                            <TextBlock Text="Ajouter"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Zone de contenu -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>