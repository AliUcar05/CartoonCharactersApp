<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartoonCharacters.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="CartoonCharacters.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cartoon Characters Collection"
        Background="#F5F5F5">

    <Grid RowDefinitions="80,*">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                BorderBrush="#34495E"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="Cartoon Characters Collection"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="Segoe UI, Arial, sans-serif"
                           LetterSpacing="0.5"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Version}"
                           Foreground="#BDC3C7"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Contenu principal avec menu horizontal -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Margin="10">
            
            <!-- Barre de navigation avec boutons, recherche et login -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0,0,0,10">
                
                <!-- Boutons de navigation à gauche -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8">
                    
                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding BackToMainCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="12"/>
                            <TextBlock Text="Accueil"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding GoToAddCartoonCharactersCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="12"/>
                            <TextBlock Text="Ajouter"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding ImportCsvCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📥" FontSize="12"/>
                            <TextBlock Text="Importer"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding ExportCsvCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📤" FontSize="12"/>
                            <TextBlock Text="Exporter"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Barre de recherche au centre -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="4"
                        Margin="10,0"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="8,0,4,0"
                                   Foreground="#7F8C8D"/>
        
                        <TextBox Grid.Column="1"
                                 Name="SearchTextBox"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Rechercher un personnage par nom..."
                                 Background="White"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Padding="4,6"
                                 Foreground="#2C3E50"
                                 CaretBrush="#2C3E50">
                            <TextBox.Styles>
                                <Style Selector="TextBox:focus /template/ Border#border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                                <Style Selector="TextBox:focus">
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>
        
                        <Button Grid.Column="2"
                                Content="✖"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Foreground="#95A5A6"
                                Cursor="Hand"
                                Padding="4,2"
                                IsVisible="{Binding HasSearchText}"/>
                    </Grid>
                </Border>

                <!-- Bouton Login à droite -->
                <Button Grid.Column="2"
                        Background="#2C3E50"
                        Foreground="White"
                        BorderBrush="#34495E"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8,6"
                        Cursor="Hand">
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="3"
                                HorizontalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="12"/>
                        <TextBlock Text="Login"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Zone de contenu -->
            <Border Grid.Row="1"
                    Background="#2C3E50"
                    CornerRadius="8"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>