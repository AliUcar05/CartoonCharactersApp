<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartoonCharacters.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="600"
        x:Class="CartoonCharacters.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="Cartoon Characters Collection"
        Background="#F5F5F5">

    <Grid RowDefinitions="80,*">
        <Border Grid.Row="0"
                Background="#2C3E50"
                BorderBrush="#34495E"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <TextBlock Text="Cartoon Characters Collection"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="Segoe UI, Arial, sans-serif"
                           LetterSpacing="0.5"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Version}"
                           Foreground="#BDC3C7"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Margin="10">

            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0,0,0,10"
                  IsVisible="{Binding ShowNavigationBar}">

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8">

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding BackToMainCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="12"/>
                            <TextBlock Text="Accueil"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding GoToAddCartoonCharactersCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="12"/>
                            <TextBlock Text="Ajouter"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding ImportCsvCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📥" FontSize="12"/>
                            <TextBlock Text="Importer"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Command="{Binding ExportCsvCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📤" FontSize="12"/>
                            <TextBlock Text="Exporter"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="4"
                        Margin="10,0"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="8,0,4,0"
                                   Foreground="#7F8C8D"/>

                        <TextBox Grid.Column="1"
                                 Name="SearchTextBox"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Rechercher un personnage par nom..."
                                 Background="White"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Padding="4,6"
                                 Foreground="#87CEEB"
                                 CaretBrush="#87CEEB">
                            <TextBox.Styles>
                                <Style Selector="TextBox:focus /template/ Border#border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                                <Style Selector="TextBox:focus">
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>

                        <Button Grid.Column="2"
                                Content="✖"
                                Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Foreground="#95A5A6"
                                Cursor="Hand"
                                Padding="4,2"
                                IsVisible="{Binding HasSearchText}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">

                    <Button Background="#2C3E50"
                            Foreground="White"
                            BorderBrush="#34495E"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,6"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="👤" FontSize="12"/>
                            <TextBlock Text="Profil"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Background="White"
                                        BorderBrush="#D0D7DE"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        MinWidth="130"
                                        MaxWidth="150">
                                    <StackPanel Spacing="8"
                                                HorizontalAlignment="Center">

                                        <Button Background="#8E44AD"
                                                Foreground="White"
                                                BorderBrush="#6C3483"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,6"
                                                Width="110"
                                                HorizontalAlignment="Center"
                                                Command="{Binding GoToAdminUsersCommand}"
                                                IsVisible="{Binding IsCurrentUserAdmin}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="🛠" FontSize="12"/>
                                                <TextBlock Text="Admin"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Background="#C0392B"
                                                Foreground="White"
                                                BorderBrush="#922B21"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,6"
                                                Width="110"
                                                HorizontalAlignment="Center"
                                                Command="{Binding LogoutCommand}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="🔑" FontSize="12"/>
                                                <TextBlock Text="Logout"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#2C3E50"
                    CornerRadius="8"
                    Padding="15">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>