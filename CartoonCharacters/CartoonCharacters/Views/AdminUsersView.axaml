<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartoonCharacters.ViewModels"
             xmlns:conv="using:CartoonCharacters.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="CartoonCharacters.Views.AdminUsersView"
             x:DataType="vm:AdminUsersViewModel"
             x:Name="Root"
             Background="#2C3E50">

    <UserControl.Styles>
        <Style Selector="Button.OutlineGreen">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineGreen:pointerover">
            <Setter Property="Background" Value="#27AE6010"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
        </Style>
        
        <Style Selector="Button.OutlineBlue">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3498DB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#3498DB"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineBlue:pointerover">
            <Setter Property="Background" Value="#3498DB10"/>
            <Setter Property="BorderBrush" Value="#5DADE2"/>
        </Style>
        
        <Style Selector="Button.OutlineGray">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#7F8C8D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineGray:pointerover">
            <Setter Property="Background" Value="#7F8C8D10"/>
            <Setter Property="BorderBrush" Value="#95A5A6"/>
        </Style>
        
        <Style Selector="Button.OutlineRed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="Button.OutlineRed:pointerover">
            <Setter Property="Background" Value="#E74C3C10"/>
            <Setter Property="BorderBrush" Value="#EC7063"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12"
          Margin="20">

        <Border Background="#34495E"
                CornerRadius="10"
                Padding="16">
            <TextBlock Text="Administration des utilisateurs"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Content="➕ Créer un utilisateur"
                    Command="{Binding CreateUserCommand}"
                    Classes="OutlineGreen"/>

            <Button Grid.Column="1"
                    Content="🔄 Rafraîchir"
                    Command="{Binding RefreshCommand}"
                    Classes="OutlineBlue"/>

            <Border Grid.Column="3"
                    Background="Transparent">
                <Button Content="⬅ Retour"
                        Command="{Binding BackCommand}"
                        Classes="OutlineGray"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#36393F"
                CornerRadius="10"
                Padding="16">

            <Grid RowDefinitions="Auto,*">

                <Grid ColumnDefinitions="2*,2*,2*,3*,2*,Auto,Auto"
                      Margin="0,0,0,10">
                    <TextBlock Grid.Column="0"
                               Text="Nom d'utilisateur"
                               FontWeight="Bold"
                               Foreground="#ECF0F1"
                               FontSize="12"/>
                    <TextBlock Grid.Column="1"
                               Text="Prénom"
                               FontWeight="Bold"
                               Foreground="#ECF0F1"
                               FontSize="12"/>
                    <TextBlock Grid.Column="2"
                               Text="Nom"
                               FontWeight="Bold"
                               Foreground="#ECF0F1"
                               FontSize="12"/>
                    <TextBlock Grid.Column="3"
                               Text="Email"
                               FontWeight="Bold"
                               Foreground="#ECF0F1"
                               FontSize="12"/>
                    <TextBlock Grid.Column="4"
                               Text="Rôle"
                               FontWeight="Bold"
                               Foreground="#ECF0F1"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Users}"
                                  x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2C3E50"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,6"
                                        BorderBrush="#34495E"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="2*,2*,2*,3*,2*,Auto,Auto"
                                          ColumnSpacing="8">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding UserName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#ECF0F1"
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FirstName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#ECF0F1"
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding LastName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#ECF0F1"
                                                   FontSize="12"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Email}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#ECF0F1"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding IsAdmin, Converter={x:Static conv:BooleanToRoleConverter.Instance}}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#F39C12"
                                                   FontWeight="SemiBold"/>

                                        <Button Grid.Column="5"
                                                Content="Modifier"
                                                Classes="OutlineBlue"
                                                Padding="8,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.EditUserCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"/>

                                        <Button Grid.Column="6"
                                                Content="Supprimer"
                                                Classes="OutlineRed"
                                                Padding="8,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.DeleteUserCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>