<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CartoonCharacters.App"
             xmlns:local="using:CartoonCharacters"
             xmlns:converters="clr-namespace:CartoonCharacters.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

     <Application.Resources>
         <converters:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
         <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
         <converters:StatusToBackgroundConverter x:Key="StatusToBackgroundConverter"/>
         <converters:StatusToTextConverter x:Key="StatusToTextConverter"/>
         <converters:StatusToEnabledConverter x:Key="StatusToEnabledConverter"/>
         <converters:IsAllCollectionsFilterConverter x:Key="IsAllCollectionsFilterConverter"/>
     </Application.Resources>
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>